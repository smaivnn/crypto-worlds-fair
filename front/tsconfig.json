{
    "files": [],
    "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@assets/*": ["src/assets/*"],
            "@components/*": ["src/components/*"],
            "@constants/*": ["src/constants/*"],
            "@hooks/*": ["src/hooks/*"],
            "@pages/*": ["src/pages/*"],
            "@routes/*": ["src/routes/*"],
            "@config/*": ["src/config/*"]
        },
        "resolveJsonModule": true, // JSON 파일을 모듈로 가져올 수 있도록 설정
        "esModuleInterop": true // CommonJS 모듈 호환성 활성화
    }
}
